{
  "version": "1.0.1",
  "license": "AGPL-3.0-or-later",
  "name": "@constl/relai-libp2p",
  "author": "Julien Jean Malard-Adam",
  "type": "module",
  "types": "./dist/src/index.d.ts",
  "exports": "./dist/src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "nettoyer": "rimraf dist",
    "compiler": "pnpm versioner && pnpm formatter && pnpm nettoyer && pnpm tspc -p tsconfig.json",
    "compiler:prod": "pnpm versioner && pnpm formatter && pnpm nettoyer && pnpm tspc -p tsconfig.build.json",
    "test": "pnpm compiler && pnpm aegir test -t node --cov",
    "test:navig": "pnpm compiler && pnpm aegir test -t browser --cov",
    "formatter": "pnpm prettier --ignore-path .gitignore --write \"**/*.+(js|ts|json)\" && pnpm eslint",
    "versioner": "pnpm genversion  --es6 --semi src/version.ts",
    "lancer": "pnpm compiler && touch .env && node --env-file=.env dist/src/serveur.js",
    "effacer-pairs": "rimraf .libp2p"
  },
  "watch": {
    "build": {
      "patterns": "./src/**/*",
      "extensions": [
        ".ts",
        ".tsx"
      ]
    },
    "postbuild": "./dist/**/*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@libp2p/logger": "^6.2.16",
    "@multiformats/multiaddr": "^13.0.3",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.6",
    "@types/file-saver": "^2.0.7",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.8",
    "@types/serve-static": "^2.2.0",
    "aegir": "^48.2.0",
    "axios": "^1.21.1",
    "browserify-fs": "^1.0.0",
    "core-js": "^3.51.0",
    "cors": "^2.8.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "execa": "^10.2.1",
    "globals": "^17.14.0",
    "mocha": "^12.0.3",
    "prettier": "^3.10.1",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "ts-patch": "^4.0.1",
    "tsconfig-paths": "^4.2.0",
    "tscpaths": "^0.0.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "url-polyfill": "^1.1.14"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@chainsafe/libp2p-yamux": "^8.0.1",
    "@helia/block-brokers": "^5.2.4",
    "@libp2p/autonat": "^3.0.33",
    "@libp2p/bootstrap": "^12.0.37",
    "@libp2p/circuit-relay-v2": "^4.2.18",
    "@libp2p/crypto": "^5.2.0",
    "@libp2p/dcutr": "^3.0.33",
    "@libp2p/gossipsub": "^17.2.2",
    "@libp2p/identify": "^4.1.19",
    "@libp2p/interface": "^3.4.0",
    "@libp2p/peer-id": "^6.0.18",
    "@libp2p/ping": "^3.1.18",
    "@libp2p/pubsub-peer-discovery": "^12.0.0",
    "@libp2p/tcp": "^11.0.33",
    "@libp2p/webrtc": "^7.0.3",
    "@libp2p/websockets": "^10.1.26",
    "@libp2p/webtransport": "^6.0.45",
    "blockstore-core": "^7.0.1",
    "blockstore-level": "^4.0.1",
    "compression": "^1.8.2",
    "datastore-fs": "^12.0.1",
    "events": "^3.3.0",
    "express": "^5.3.0",
    "genversion": "^3.2.0",
    "libp2p": "^3.5.2",
    "p-queue": "^10.0.0",
    "rimraf": "^6.1.4",
    "serve-static": "^2.2.1",
    "uint8arrays": "^6.1.1",
    "uuid": "^14.0.3",
    "wherearewe": "^2.0.1"
  }
}
